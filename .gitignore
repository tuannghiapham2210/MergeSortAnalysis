# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Java build artifacts
*.class
bin/
out/
target/
*.jar
*.war
*.ear

# IDE and Editor configs
.idea/
*.iml
.vscode/
