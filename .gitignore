*.swo

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Large dataset files (keep generated small samples, ignore huge inputs if needed)
data/inputs/*.bin
data/inputs/*.raw
data/inputs/*.large

# Logs and temp files
*.log
scratch/
